exec sh -c 'zakwas apply -y 2>first.err' &first&
exec sh -c 'until [ -e home/started ] || [ -s first.err ]; do sleep 0.1; done'

! zakwas apply -y --no-wait
stderr 'another run is in progress: "zakwas apply" \(pid \d+\); not waiting'
! stdout .

zakwas plan
stdout 'slow'
! zakwas check
stdout 'slow'

exec sh -c 'zakwas apply -y 2>second.err' &second&
exec sh -c 'until [ -s second.err ]; do sleep 0.1; done'
exec touch home/release

wait first
wait second
stdout 'up to date'
exec cat second.err
stdout 'waiting for "zakwas apply" \(pid \d+\) to finish'
exec cat home/log
cmp stdout expected-log
zakwas check

-- zakwas.yaml --
commands:
  - name: slow
    check: test -e done
    run: |
      touch started
      until [ -e release ]; do sleep 0.1; done
      echo ran >> log
      touch done
-- expected-log --
ran
