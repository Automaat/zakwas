[windows] skip 'the fake bw is an sh script'
env ZAKWAS_TEST_GOOS=darwin
chmod 755 bin/bw
cd repo

# plan and check name the notes and never start bw.
zakwas plan
stdout 'note one, note two'
! stdout 'AGE-SECRET-KEY'
! exists ../bw.log

zakwas plan -json -diff
stdout 'note one, note two'
! stdout 'AGE-SECRET-KEY'
! exists ../bw.log

! zakwas check
stdout 'note one, note two'
! exists ../bw.log

zakwas check --offline
! exists ../bw.log

# Without a terminal nothing prompts and nothing is written.
! zakwas apply -y
stderr 'in a terminal'
! exists ../bw.log
! exists ../home/keys/keys.txt

# With a terminal bw opens once and locks last.
env ZAKWAS_TEST_TTY=1
zakwas apply -y
! stdout 'AGE-SECRET-KEY'
! stderr 'AGE-SECRET-KEY'
! stdout 'SESSION-VALUE'
! stderr 'SESSION-VALUE'
grep -count=1 '^unlock --raw$' ../bw.log
grep '^lock$' ../bw.log
grep 'AGE-SECRET-KEY-1XX0PC06' ../home/keys/keys.txt
grep 'AGE-SECRET-KEY-1TAVS887' ../home/keys/keys.txt
! grep 'keep this comment out' ../home/keys/keys.txt
! grep 'AGE-SECRET-KEY' ../home/.local/state/zakwas/history.jsonl
! grep 'SESSION-VALUE' ../home/.local/state/zakwas/history.jsonl

# Converged: nothing to do and bw stays closed.
rm ../bw.log
zakwas check
stdout 'up to date: .*\bsecrets\b'
zakwas apply -y
! exists ../bw.log

# A note with the wrong key changes nothing and still locks.
cp zakwas-wrong.yaml zakwas.yaml
cp ../home/keys/keys.txt ../before.txt
! zakwas apply -y
stderr 'doesn.t hold the key'
stderr 'is unchanged'
! stderr 'AGE-SECRET-KEY'
cmp ../home/keys/keys.txt ../before.txt
grep '^lock$' ../bw.log

-- repo/zakwas.yaml --
secrets:
  age:
    - dst: ~/keys/keys.txt
      keys:
        - {bitwarden: note one, publicKey: age1edvv45phvvnm3vn3ryg99funk5rj0q2wm6lcncavghdawjvs4qvsnt2l9n}
        - {bitwarden: note two, publicKey: age1as54dygxf6gu058ephml623sdh28lqg00vyuntjufvrpmxkse5lq8g6jq6}
-- repo/zakwas-wrong.yaml --
secrets:
  age:
    - dst: ~/keys/keys.txt
      keys:
        - {bitwarden: note one, publicKey: age1edvv45phvvnm3vn3ryg99funk5rj0q2wm6lcncavghdawjvs4qvsnt2l9n}
        - {bitwarden: note one, publicKey: age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p}
-- bin/bw --
#!/bin/sh
echo "$*" >> "$WORK/bw.log"
case "$1" in
    status) echo '{"status":"locked"}' ;;
    unlock) echo SESSION-VALUE ;;
    get)
        [ "$BW_SESSION" = SESSION-VALUE ] || { echo 'no session' >&2; exit 1; }
        case "$3" in
            'note one')
                echo '# keep this comment out'
                echo AGE-SECRET-KEY-1XX0PC06Z2N6MDN8L6VZLDKUN5NTQLSNRD40ZD4HTRNDXX4W0JF7SHUJDCY
                ;;
            'note two') echo AGE-SECRET-KEY-1TAVS887LFNH6XHVT43RTT3F025Y25QM5K58WP3PZW6W9M4PRS3SSDU34AY ;;
            *) echo 'Not found.' >&2; exit 1 ;;
        esac
        ;;
esac
