[windows] skip 'the fake bw and gpg are sh scripts'
env ZAKWAS_TEST_GOOS=darwin
chmod 755 bin/bw
chmod 755 bin/gpg
cd repo

zakwas plan
stdout 'gpg key 89B58A1317507C65'
stdout 'gpg main secret keys'
! stdout 'NOTE-BODY-MARKER'
! exists ../bw.log

zakwas plan -json -diff
stdout 'gpg main secret keys'
! stdout 'NOTE-BODY-MARKER'
! exists ../bw.log

! zakwas check
stdout 'gpg main secret keys'
! exists ../bw.log

zakwas check --offline
! exists ../bw.log

! zakwas apply -y
stderr 'in a terminal'
! exists ../bw.log
! exists ../imported

env ZAKWAS_TEST_TTY=1
zakwas apply -y
! stdout 'NOTE-BODY-MARKER'
! stderr 'NOTE-BODY-MARKER'
! stdout 'SESSION-VALUE'
! stderr 'SESSION-VALUE'
grep -count=1 '^unlock --raw$' ../bw.log
grep '^lock$' ../bw.log
grep 'NOTE-BODY-MARKER' ../imported
! grep 'NOTE-BODY-MARKER' ../home/.local/state/zakwas/history.jsonl
! grep 'SESSION-VALUE' ../home/.local/state/zakwas/history.jsonl

rm ../bw.log
zakwas check
stdout 'up to date: .*\bsecrets\b'
zakwas apply -y
! exists ../bw.log

rm ../imported
cp zakwas-other.yaml zakwas.yaml
! zakwas apply -y
stderr 'no secret key 0000000000000000000000000000000000000001'
! stderr 'NOTE-BODY-MARKER'
grep '^lock$' ../bw.log

-- repo/zakwas.yaml --
secrets:
  gpg:
    - {bitwarden: gpg main secret keys, fingerprint: 4C87E4377EC834C405AE619989B58A1317507C65}
-- repo/zakwas-other.yaml --
secrets:
  gpg:
    - {bitwarden: gpg main secret keys, fingerprint: "0000000000000000000000000000000000000001"}
-- bin/bw --
#!/bin/sh
echo "$*" >> "$WORK/bw.log"
case "$1" in
    status) echo '{"status":"locked"}' ;;
    unlock) echo SESSION-VALUE ;;
    get)
        [ "$BW_SESSION" = SESSION-VALUE ] || { echo 'no session' >&2; exit 1; }
        case "$3" in
            'gpg main secret keys')
                echo '-----BEGIN PGP PRIVATE KEY BLOCK-----'
                echo NOTE-BODY-MARKER
                echo '-----END PGP PRIVATE KEY BLOCK-----'
                ;;
            *) echo 'Not found.' >&2; exit 1 ;;
        esac
        ;;
esac
-- bin/gpg --
#!/bin/sh
case "$*" in
    *--list-secret-keys*)
        if [ -f "$WORK/imported" ]; then
            echo 'sec:u:255:22:C25DFDF396ADF455:1764115200:::u:::cESCA:::+:::ed25519:::0:'
            echo 'fpr:::::::::904F9010E4362132E576865EC25DFDF396ADF455:'
            echo 'ssb:u:255:22:89B58A1317507C65:1764115200:1795651200:::::s:::+:::ed25519::'
            echo 'fpr:::::::::4C87E4377EC834C405AE619989B58A1317507C65:'
        fi
        ;;
    *--import*) cat > "$WORK/imported" ;;
esac
