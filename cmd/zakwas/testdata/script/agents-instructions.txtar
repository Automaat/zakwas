mkdir claude
cp mine.md claude/CLAUDE.md
env CLAUDE_CONFIG_DIR=$WORK/claude
env CODEX_HOME=$WORK/codex

zakwas plan --only agents
cmpenv stdout plan.golden
! exists codex
! exists home/.config/opencode
! exists home/.local/state/zakwas/instruction-files.json

zakwas apply -y --only agents
stdout 'Applied 3 of 3 steps'
cmp claude/CLAUDE.md AGENTS.md
cmp codex/AGENTS.md AGENTS.md
cmp home/.config/opencode/AGENTS.md AGENTS.md
cmp claude/CLAUDE.md.zakwas-bak mine.md
exists home/.local/state/zakwas/instruction-files.json

zakwas check --only agents
stdout 'up to date: agents'

cp zakwas-claude.yaml zakwas.yaml
zakwas plan --only agents
cmpenv stdout drop.golden
zakwas apply -y --only agents
! exists codex/AGENTS.md
! exists home/.config/opencode/AGENTS.md
cmp claude/CLAUDE.md AGENTS.md
zakwas check --only agents
stdout 'up to date: agents'

cp zakwas-missing.yaml zakwas.yaml
! zakwas plan --only agents
stdout 'agents.instructions: source .*/nope.md: no such file or directory'
cmp claude/CLAUDE.md AGENTS.md

cp zakwas-none.yaml zakwas.yaml
zakwas plan --only agents
stdout 'instructions no longer managed'
zakwas apply -y --only agents
! exists claude/CLAUDE.md
exists claude/CLAUDE.md.zakwas-bak
! exists home/.local/state/zakwas/instruction-files.json
zakwas check --only agents
stdout 'up to date: agents'

cp zakwas-claude.yaml zakwas.yaml
zakwas apply -y --only agents
cmp claude/CLAUDE.md AGENTS.md
cp zakwas-empty.yaml zakwas.yaml
zakwas plan
stdout 'instructions no longer managed'
zakwas apply -y
! exists claude/CLAUDE.md
! exists home/.local/state/zakwas/instruction-files.json
zakwas check
! stdout agents

-- mine.md --
hand-written
-- AGENTS.md --
be terse
-- zakwas.yaml --
agents:
  guard: false
  providers: [claude, codex, opencode]
  instructions: AGENTS.md
-- zakwas-claude.yaml --
agents:
  guard: false
  providers: [claude]
  instructions: AGENTS.md
-- zakwas-missing.yaml --
agents:
  guard: false
  providers: [claude]
  instructions: nope.md
-- zakwas-none.yaml --
agents:
  guard: false
  providers: [claude]
-- zakwas-empty.yaml --
links: []
-- plan.golden --
agents
  ~ $WORK/claude/CLAUDE.md  not managed yet, back up to CLAUDE.md.zakwas-bak
  + $WORK/codex/AGENTS.md
  + ~/.config/opencode/AGENTS.md

Plan: 2 to add, 1 to change, 0 to remove, 0 to run.
-- drop.golden --
agents
  - $WORK/codex/AGENTS.md  instructions no longer managed
  - ~/.config/opencode/AGENTS.md              instructions no longer managed

⚠ destructive: $WORK/codex/AGENTS.md, ~/.config/opencode/AGENTS.md

Plan: 0 to add, 0 to change, 2 to remove, 0 to run.
