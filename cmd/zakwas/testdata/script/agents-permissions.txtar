env CLAUDE_CONFIG_DIR=$WORK/claude
env CODEX_HOME=$WORK/codex

zakwas plan --only templates,agents
cmpenv stdout plan.golden

zakwas apply -y --only templates,agents
stdout 'Applied 3 of 3 steps'
cmp claude/settings.json settings.golden
grep -count=6 '(?m)^.' codex/rules/zakwas.rules
grep -count=1 '^# Generated by zakwas from agents.permissions in zakwas.yaml; change it there.$' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["git", "status"\], decision="allow"\)$' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["sed", "-n"\], decision="allow"\)$' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["peekaboo", "see"\], decision="allow"\)$' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["git", "push"\], decision="prompt"\)$' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["git", "push", "--force"\], decision="forbidden", justification="use --force-with-lease"\)$' codex/rules/zakwas.rules
cmp codex/rules/default.rules default.golden
cmp home/.config/opencode/opencode.json opencode.golden
exists home/.local/state/zakwas/agent-permissions.json

zakwas check --only templates,agents
stdout 'up to date: templates, agents'

cp zakwas-update.yaml zakwas.yaml
zakwas plan --only agents
cmpenv stdout plan-update.golden
zakwas apply -y --only templates,agents
grep -count=5 '(?m)^.' codex/rules/zakwas.rules
grep -count=1 '^prefix_rule\(pattern=\["git", "diff"\], decision="allow"\)$' codex/rules/zakwas.rules
! grep 'sed|peekaboo' codex/rules/zakwas.rules
zakwas check --only templates,agents

cp zakwas-none.yaml zakwas.yaml
zakwas plan --only templates,agents
cmpenv stdout plan-none.golden
zakwas apply -y --only templates,agents
cmp claude/settings.json settings-user.golden
! exists codex/rules/zakwas.rules
cmp codex/rules/default.rules default.golden
! exists home/.local/state/zakwas/agent-permissions.json
grep '"bash": \{"\*": "ask"\}' home/.config/opencode/opencode.json
zakwas check
stdout 'No changes'
! stdout agents

-- zakwas.yaml --
templates:
  files:
    - {src: opencode.json.tmpl, dst: ~/.config/opencode/opencode.json}
agents:
  guard: false
  providers: [claude, codex, opencode]
  permissions:
    allow:
      - git status
      - sed -n
      - {command: peekaboo see, providers: [codex]}
    review:
      - git push
    deny:
      - {command: git push --force, justification: use --force-with-lease}
-- zakwas-update.yaml --
templates:
  files:
    - {src: opencode.json.tmpl, dst: ~/.config/opencode/opencode.json}
agents:
  guard: false
  providers: [claude, codex, opencode]
  permissions:
    allow:
      - git status
      - git diff
    review:
      - git push
    deny:
      - {command: git push --force, justification: use --force-with-lease}
-- zakwas-none.yaml --
templates:
  files:
    - {src: opencode.json.tmpl, dst: ~/.config/opencode/opencode.json}
-- opencode.json.tmpl --
{
  "permission": {
    "bash": {{ agentPermissions "opencode" "ask" }}
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {{ agentPermissions "opencode" "allow" }}
      }
    }
  }
}
-- claude/settings.json --
{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(ls:*)"
    ],
    "defaultMode": "auto"
  }
}
-- codex/rules/default.rules --
prefix_rule(pattern=["git", "push"], decision="allow")
-- default.golden --
prefix_rule(pattern=["git", "push"], decision="allow")
-- plan.golden --
templates
  + ~/.config/opencode/opencode.json
agents
  ~ $WORK/claude/settings.json  permissions +1 allow, +1 deny
  + $WORK/codex/rules/zakwas.rules  permissions +3 allow, +1 prompt, +1 forbidden

Plan: 2 to add, 1 to change, 0 to remove, 0 to run.
-- settings.golden --
{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(sed -n:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git push --force:*)"
    ]
  }
}
-- opencode.golden --
{
  "permission": {
    "bash": {"*": "ask", "git status": "allow", "git status *": "allow", "sed -n": "allow", "sed -n *": "allow", "git push": "ask", "git push *": "ask", "git push --force": "deny", "git push --force *": "deny"}
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {"*": "allow", "git status": "allow", "git status *": "allow", "sed -n": "allow", "sed -n *": "allow", "git push": "ask", "git push *": "ask", "git push --force": "deny", "git push --force *": "deny"}
      }
    }
  }
}
-- plan-update.golden --
agents
  ~ $WORK/claude/settings.json  permissions -1 allow, +1 allow
  ~ $WORK/codex/rules/zakwas.rules  permissions -2 allow, +1 allow

Plan: 0 to add, 2 to change, 0 to remove, 0 to run.
-- plan-none.golden --
templates
  ~ ~/.config/opencode/opencode.json  content
agents
  ~ $WORK/claude/settings.json  permissions -1 allow, -1 deny
  - $WORK/codex/rules/zakwas.rules  permissions -2 allow, -1 prompt, -1 forbidden

⚠ destructive: $WORK/codex/rules/zakwas.rules

Plan: 0 to add, 2 to change, 1 to remove, 0 to run.
-- settings-user.golden --
{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(ls:*)"
    ],
    "defaultMode": "auto"
  }
}
